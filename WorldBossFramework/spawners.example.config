; WorldBossFramework PalSchema arena definitions
;
; Changes take effect after a full server restart. map_x and map_y are the
; coordinates shown by Palworld's in-game map overlay. World X/Y and terrain Z
; are resolved automatically. ground_clearance is centimeters above terrain.
; The summon command uses the entry name: !worldboss summon test_arena

spawners.test_arena.enabled = true
spawners.test_arena.title = "The Woolen Calamity"
spawners.test_arena.auto_enabled = true
spawners.test_arena.queue_order = 10
spawners.test_arena.map_x = 95
spawners.test_arena.map_y = -520
spawners.test_arena.ground_clearance = 100
spawners.test_arena.rotation_pitch = 0
spawners.test_arena.rotation_yaw = 0
spawners.test_arena.rotation_roll = 0
spawners.test_arena.pal_id.1 = SheepBall
spawners.test_arena.level.1 = 5
spawners.test_arena.scale.1 = 1.5
spawners.test_arena.match_radius = 5000
spawners.test_arena.respawn_player_radius = 15000

; Optional PlayerTitleFramework title granted to every in-range player on the
; first natural defeat of this world-boss profile.
; spawners.test_arena.first_defeat_title = world_boss_champion

; Natural defeat snapshots players inside match_radius. Each row rolls once
; per eligible player and remains claimable with !worldboss claim.
spawners.test_arena.reward.1.item = AncientCivilizationParts
spawners.test_arena.reward.1.count = 5
spawners.test_arena.reward.1.chance = 1.0
spawners.test_arena.reward.2.item = Money
spawners.test_arena.reward.2.count = 100
spawners.test_arena.reward.2.chance = 0.25

; Currency rewards remain in the same persistent !worldboss claim ledger.
; They require ServerShopFramework API 1 when the player claims them.
spawners.test_arena.reward.3.kind = currency
spawners.test_arena.reward.3.count = 250
spawners.test_arena.reward.3.chance = 1.0

; Optional ServerShopFramework early-summon offer. The contributed offer ID is
; worldboss_<spawner ID>; this example becomes worldboss_test_arena.
; Only virtual currency is accepted so a failed summon can use the shop's
; proven automatic currency-refund path.
spawners.test_arena.shop_offer_enabled = false
spawners.test_arena.shop_currency_cost = 1000
spawners.test_arena.shop_max_purchases = 0
spawners.test_arena.shop_cooldown_seconds = 0
; false resumes the paused countdown after defeat; true starts a full interval.
spawners.test_arena.shop_reset_schedule = false

; v0.5.3: member separation; building restriction remains suspended.
; Effective separation is member_spacing times the largest member scale.
spawners.test_arena.arena_radius = 15000
spawners.test_arena.block_building = false
spawners.test_arena.member_spacing = 800

; Alpha and Predator are mutually exclusive. Alpha uses the BOSS_<pal_id> row
; for natural Alpha size; Predator uses runtime Predator type on the base row.
spawners.test_arena.alpha.1 = true
spawners.test_arena.predator.1 = false
spawners.test_arena.uncapturable.1 = true

; Per-instance combat rates. defense_multiplier is converted to the inverse
; EnemyReceiveDamageRate, so 2.0 means the boss takes half damage.
spawners.test_arena.hp_multiplier.1 = 1000.0
spawners.test_arena.attack_multiplier.1 = 1.5
spawners.test_arena.defense_multiplier.1 = 20.0

; Exact EPalWazaID and passive-skill FName values. Up to 3 active and 4 passive.
spawners.test_arena.active_skill_1.1 = HyperBeam
spawners.test_arena.active_skill_2.1 = PowerBall
spawners.test_arena.active_skill_3.1 = HolyBlast
spawners.test_arena.passive_skill_1.1 = WorldTree_ATK_DEF
spawners.test_arena.passive_skill_2.1 = CoolTimeReduction_Up_1
spawners.test_arena.passive_skill_3.1 = CoolTimeReduction_Up_2
spawners.test_arena.passive_skill_4.1 = Deffence_up3

; To add a second Pal, configure pal_id.2, level.2, alpha.2, etc.
; Active skill slot 2 of member 1 is active_skill_2.1.
; Member indices must be contiguous. No count field is accepted.
; RAID_/GYM_ IDs preserve their native active skills; configured skills are ignored.
