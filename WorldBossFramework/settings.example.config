; WorldBossFramework 0.7.1 multi-Pal coordination controller
;
; On first load Palladium copies this file to:
; ue4ss/Mods/Palladium/mods/WorldBossFramework/settings.config
;
; Keep probe_enabled false until the startup log reports config=ready,
; guard=true, native_ready=true, and the selected spawner is locked.

enabled = true
probe_enabled = false

; Automatic scheduling is intentionally off for the first deployment. After
; startup reports controller_mode=disabled, config=ready, guard=true, and
; native_ready=true, set this to true.
controller.enabled = false
; ascending, descending, or random. Each round visits every enabled arena once.
; Ties are shuffled. A saved in-progress queue retains its order after restart.
controller.queue_order = ascending
controller.initial_delay_seconds = 900
controller.spawn_interval_seconds = 7200
controller.due_retry_seconds = 1
controller.recovery_delay_seconds = 30

; false resumes from the most recently checkpointed remainder instead of
; counting time while the server process was offline.
controller.count_server_downtime = false

; Spawn announcement tokens: [Boss Title], [Level], [Map X], [Map Y], [Spawner].
; [Level] is the highest configured member level, also used by public find.
; The automatic spawn announcement fires as soon as the timer reaches zero,
; including while the selected arena remains in due-waiting state.
announcements.spawn = [Boss Title] (Lv.[Level]) has appeared at map [Map X], [Map Y]!
; Defeat and next-spawn announcements use the fixed 0.7.x format and do not
; use the legacy announcements.defeat template.

; The framework unlocks only the selected spawner for one bounded request,
; then applies its own disable flag again after this delay.
spawner_relock_delay_ms = 10000

; Optional fallback when the host does not expose Palworld's native bAdmin flag.
; administrator_uids.1 = 00000000000000000000000000000000

[nodes]
worldbossframework.probe_command = allow
worldbossframework.admin = deny
